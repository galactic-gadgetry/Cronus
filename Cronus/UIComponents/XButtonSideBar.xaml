<UserControl x:Class="Cronus.UIComponents.XButtonSideBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.UIComponents"
             mc:Ignorable="d" d:DesignHeight="650">
    
    <Grid>
        <Border>

            <Grid Width="315" Margin="0,55,0,0">
                <!-- #X Button -->
                <Button>
                    <Button.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Height" Value="35"/>
                            <Setter Property="Width" Value="35"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <!-- #Mouse over behaviors -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Ellipse
                            StrokeThickness="2">
                            <Ellipse.Resources>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="{StaticResource IconButtonBackground}"/>
                                    <Style.Triggers>
                                        <!-- #Mouse over behaviors -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource IconButtonBackgroundMouseOver}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Resources>
                        </Ellipse>

                        <Image Margin="5">
                            <Image.Resources>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource LetterXGray}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource LetterXWhite}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Resources>
                        </Image>
                    </Grid>
                </Button>
                
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
