<UserControl x:Class="Cronus.Views.EditProjectDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.Views"
             mc:Ignorable="d">
    
    <Grid>
        <Border Style="{StaticResource ViewBorderStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- #View Title -->
                <Label
                    Grid.Row="0"
                    Content="Edit Project Details"
                    Style="{StaticResource ViewTitleLabelStyle}"/>
                
                <!-- #View Contents -->
                <Border Grid.Row="1" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource ControlBackgroundFillColorBrush1}"/>
                                <Setter Property="BorderThickness" Value="0,1"/>
                                <Setter Property="Padding" Value="0,15"/>
                            </Style>

                            <Style TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
                                <Setter Property="FontSize" Value="{StaticResource SmallLabelFontSize}"/>
                            </Style>

                            <Style TargetType="TextBox" BasedOn="{StaticResource DialogInputFieldTextBoxStyle}"/>
                        </StackPanel.Resources>
                        <Border>
                            <StackPanel>
                                <Label Content="NAME"/>
                                <TextBox Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <Label Content="CODE"/>
                                <TextBox Text="{Binding CodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <Label Content="WBS"/>
                                <TextBox Text="{Binding WbsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- #Controls -->
                        <Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Content="Back"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    Command="{Binding BackButtonClickedCommand}"/>

                                <Button
                                    Grid.Column="1"
                                    Content="Save"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding SaveButtonClickedCommand}"
                                    IsDefault="True"
                                    IsEnabled="{Binding AreInputsValid}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
