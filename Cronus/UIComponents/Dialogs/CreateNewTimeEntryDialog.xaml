<Window x:Class="Cronus.UIComponents.Dialogs.CreateNewTimeEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cronus.UIComponents.Dialogs"
        mc:Ignorable="d"
        Title="Create New Time Entry"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=TitleTextBox}">
    
    <Grid>
        <Border>

            <Border Style="{StaticResource DialogOutterBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DialogContentBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- #Title -->
                            <Label
                                Grid.Row="0"
                                Content="New entry"
                                Style="{StaticResource DialogTitleLabelStyle}"/>
                            
                            <!-- #Message -->
                            <TextBlock
                                Grid.Row="1"
                                Text="Details for the new entry."
                                Style="{StaticResource DialogContentTextBlockStyle}"/>
                            
                            <!-- #Inputs -->
                            <StackPanel Grid.Row="2">
                                <StackPanel.Resources>
                                    <Style TargetType="Label" BasedOn="{StaticResource DialogInputFieldHeaderLabelStyle}"/>

                                    <Style TargetType="StackPanel" BasedOn="{StaticResource DialogInputFieldStackPanelStyle}"/>

                                    <Style TargetType="TextBox" BasedOn="{StaticResource DialogInputFieldTextBoxStyle}"/>
                                </StackPanel.Resources>
                                <StackPanel>
                                    <Label Content="ENTRY TITLE"/>
                                    <TextBox Text="Test Title"/>
                                </StackPanel>
                                <StackPanel>
                                    <Label Content="PROJECT"/>
                                    <ComboBox SelectedIndex="0">
                                        SpaceY
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <Label Content="TIME"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ComboBox SelectedIndex="0">
                                            <ComboBoxItem>01</ComboBoxItem>
                                            <ComboBoxItem>02</ComboBoxItem>
                                        </ComboBox>
                                        <Label Content=":"/>
                                        <ComboBox SelectedIndex="0">
                                            00
                                        </ComboBox>
                                        <ComboBox SelectedIndex="0">
                                            AM
                                        </ComboBox>
                                        <Label Content="-"/>
                                        <ComboBox SelectedIndex="0">
                                            <ComboBoxItem>05</ComboBoxItem>
                                            <ComboBoxItem>06</ComboBoxItem>
                                        </ComboBox>
                                        <Label Content=":"/>
                                        <ComboBox SelectedIndex="0">
                                            00
                                        </ComboBox>
                                        <ComboBox SelectedIndex="0">
                                            AM
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <Label Content="DESCRIPTION"/>
                                    <TextBox/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- #Controls -->
                    <Border
                        Grid.Row="1"
                        Style="{StaticResource DialogControlBorderStyle}"
                        Background="{StaticResource ControlBackgroundFillColorBrush2}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Content="Back"
                                Background="Transparent"
                                HorizontalAlignment="Left"/>

                            <Button
                                Grid.Column="1"
                                Content="Create"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="85"
                                HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            
        </Border>
    </Grid>
    
</Window>
