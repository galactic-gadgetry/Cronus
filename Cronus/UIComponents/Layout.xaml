<UserControl x:Class="Cronus.UIComponents.Layout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.UIComponents"
             xmlns:view="clr-namespace:Cronus.Views"
             xmlns:vm="clr-namespace:Cronus.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #Navigation Bar -->
                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
                    <Grid>
                        <ContentControl Content="{Binding CurrentNavigationBarViewModel}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type vm:SettingsNavigationBarViewModel}">
                                    <local:SettingsNavigationBar/>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </Grid>
                </Border>
                
                <!-- #Main Content -->
                <Border Grid.Column="1" Grid.Row="0">
                    <Grid>
                        <ScrollViewer Content="{Binding CurrentContentViewModel}">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
                                    <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                </Style>

                                <DataTemplate DataType="{x:Type vm:BookDetailsViewModel}">
                                    <view:BookDetailsView/>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:SavedBooksViewModel}">
                                    <view:SavedBooksView/>
                                </DataTemplate>
                            </ScrollViewer.Resources>
                        </ScrollViewer>
                    </Grid>
                </Border>
                
                <!-- #Side Content -->
                <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
                    <ContentControl Content="{Binding CurrentSideContentViewModel}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:XButtonSideBarViewModel}">
                                <local:XButtonSideBar/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
                
                <!-- #Info Bar -->
                <Border Grid.Column="1" Grid.Row="1">
                    <Label Content="{Binding InfoText}" FontSize="9"/>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
