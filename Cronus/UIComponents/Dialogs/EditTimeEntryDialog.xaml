<Window x:Class="Cronus.UIComponents.Dialogs.EditTimeEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cronus.UIComponents.Dialogs"
        mc:Ignorable="d"
        Title="Edit Time Entry"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner">
    
    <Grid>
        <Border>

            <Border Style="{StaticResource DialogOutterBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DialogContentBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- #Title -->
                            <Label
                                Grid.Row="0"
                                Content="Edit time entry"
                                Style="{StaticResource DialogTitleLabelStyle}"/>
                            
                            <!-- #Inputs -->
                            <StackPanel Grid.Row="1">
                                <StackPanel.Resources>
                                    <Style TargetType="Label" BasedOn="{StaticResource DialogInputFieldHeaderLabelStyle}"/>

                                    <Style TargetType="StackPanel" BasedOn="{StaticResource DialogInputFieldStackPanelStyle}"/>

                                    <Style TargetType="TextBox" BasedOn="{StaticResource DialogInputFieldTextBoxStyle}"/>
                                </StackPanel.Resources>

                                <StackPanel>
                                    <Label Content="ENTRY TITLE"/>
                                    <TextBox x:Name="TitleTextBox"/>
                                </StackPanel>

                                <StackPanel>
                                    <Label Content="PROJECT"/>
                                    <ComboBox
                                        x:Name="ProjectComboBox"
                                        ItemsSource="{Binding Projects}"
                                        DisplayMemberPath="Name"/>
                                </StackPanel>

                                <StackPanel>
                                    <Label Content="TIME"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                                                <Setter Property="Margin" Value="5,0"/>
                                            </Style>

                                            <Style TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
                                                <Setter Property="Margin" Value="5,0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="20"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </Style>
                                        </StackPanel.Resources>
                                        <ComboBox
                                            x:Name="StartHourComboBox"
                                            ItemsSource="{Binding Hours}"
                                            SelectedIndex="0"/>
                                        <Label Content=":"/>
                                        <ComboBox
                                            x:Name="StartMinuteComboBox"
                                            ItemsSource="{Binding Minutes}"
                                            SelectedIndex="0"/>
                                        <ComboBox
                                            x:Name="StartMeridiemComboBox"
                                            ItemsSource="{Binding Meridiems}"
                                            SelectedIndex="0"/>
                                        <Label Content="-"/>
                                        <ComboBox
                                            x:Name="EndHourComboBox"
                                            ItemsSource="{Binding Hours}"
                                            SelectedIndex="0"/>
                                        <Label Content=":"/>
                                        <ComboBox
                                            x:Name="EndMinuteComboBox"
                                            ItemsSource="{Binding Minutes}"
                                            SelectedIndex="0"/>
                                        <ComboBox
                                            x:Name="EndMeridiemComboBox"
                                            ItemsSource="{Binding Meridiems}"
                                            SelectedIndex="0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <Label Content="DESCRIPTION"/>
                                    <TextBox
                                        x:Name="DescriptionTextBox"
                                        Height="100"
                                        HorizontalAlignment="Stretch"
                                        VerticalContentAlignment="Top"
                                        MaxLength="1024"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- #Controls -->
                    <Border
                        Grid.Row="1"
                        Style="{StaticResource DialogControlBorderStyle}"
                        Background="{StaticResource ControlBackgroundFillColorBrush2}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Content="Back"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Click="BackButton_Click"/>

                            <Button
                                Grid.Column="1"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="85"
                                HorizontalAlignment="Right"
                                Click="SaveButton_Click"
                                IsDefault="True"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            
        </Border>
    </Grid>
    
</Window>
