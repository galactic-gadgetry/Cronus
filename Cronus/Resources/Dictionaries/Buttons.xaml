<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBorderBackground}"/>
        <Setter Property="Padding" Value="5,4,4,5"/>
        <Style.Triggers>
            <!-- #Mouse over behaviors -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentIconButtonBackgroundMouseOver}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>