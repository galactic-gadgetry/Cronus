<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <!-- #Colors -->
    <Color x:Key="BannerColorPrimary100">#61554C</Color>
    <Color x:Key="BannerColorPrimary130">#221E1A</Color>
    
    
    <!-- #Border -->
    <SolidColorBrush x:Key="AccentBorderBackground" Color="{StaticResource BannerColorPrimary100}"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource BannerColorPrimary100}"/>

    <!-- #Button -->
    <SolidColorBrush x:Key="IconButtonBackground" Color="{StaticResource TextControlColorPrimary90}"/>
    <SolidColorBrush x:Key="IconButtonBackgroundMouseOver" Color="White"/>

    <SolidColorBrush x:Key="AccentIconButtonBackgroundMouseOver" Color="{StaticResource BannerColorPrimary130}"/>

</ResourceDictionary>