<UserControl x:Class="Cronus.Views.EditBookDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.Views"
             mc:Ignorable="d">
    
    <Grid>
        <Border Style="{StaticResource ViewBorderStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- #View Title -->
                <Label
                    Grid.Row="0"
                    Content="Edit Book Details"
                    Style="{StaticResource ViewTitleLabelStyle}"/>
                
                <!-- #View Contents -->
                <Border Grid.Row="1" Margin="0,20,0,0">
                    <StackPanel>
                        <Border
                            BorderBrush="{StaticResource ControlBackgroundFillColorBrush1}"
                            BorderThickness="0,1"
                            Padding="0,15">
                            <StackPanel>
                                <Label
                                    Content="NAME"
                                    FontSize="{StaticResource SmallLabelFontSize}"/>
                                <TextBox
                                    Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DialogInputFieldTextBoxStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Content="Back"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    Command="{Binding BackButtonClickedCommand}"/>
                                <Button
                                    Grid.Column="1"
                                    Content="Save"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding SaveButtonClickedCommand}"
                                    IsEnabled="{Binding AreInputsValid}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
