<UserControl x:Class="Cronus.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.Views"
             xmlns:card="clr-namespace:Cronus.UIComponents.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="450">
    
    <Grid>
        <Border
            Style="{StaticResource ViewBorderStyle}"
            HorizontalAlignment="Stretch">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- #View Title -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Column="0"
                        Content="Projects"
                        Style="{StaticResource ViewTitleLabelStyle}"/>

                    <Button
                        Grid.Column="1"
                        Content="Create Project"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,15,0"
                        Command="{Binding CreateProjectButtonClickedCommand}"/>
                </Grid>
                
                <!-- #View Contents -->
                <Border Grid.Row="1" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- TODO: Add filter row -->
                        <Border Grid.Row="0"/>
                        
                        <!-- #Projects List -->
                        <ListView
                            x:Name="ProjectsListView"
                            ItemsSource="{Binding ProjectStatistics}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <card:ProjectListCard
                                        NameText="{Binding Name}"
                                        CodeText="{Binding Code}"
                                        WbsText="{Binding Wbs}"
                                        StatusText="{Binding StatusText}"
                                        TotalTimeText="{Binding DurationString}"
                                        TimeEntriesCountText="{Binding TimeEntriesCountString}"
                                        DeleteButtonClickedCommand="{Binding DataContext.ProjectCardDeleteButtonClickedCommand, ElementName=ProjectsListView}"
                                        DeleteButtonClickedCommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}"
                                        EditButtonClickedCommand="{Binding DataContext.ProjectCardEditButtonClickedCommand, ElementName=ProjectsListView}"
                                        EditButtonClickedCommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}"
                                        NameHyperlinkClickedCommand="{Binding DataContext.ProjectCardNameHyperlinkClickedCommand, ElementName=ProjectsListView}"
                                        NameHyperlinkClickedCommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
