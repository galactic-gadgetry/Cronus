<UserControl x:Class="Cronus.UIComponents.SettingsNavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.UIComponents"
             mc:Ignorable="d" d:DesignHeight="450"
             MinWidth="238">
    
    <Grid>
        <Border Background="{StaticResource LayerFillColorBrush2}">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="237"/>
                    <ColumnDefinition Width="238"/>
                </Grid.ColumnDefinitions>
                
                <!-- #Empty Side -->
                <Border Grid.Column="0"/>
                
                <!-- #Navigation Buttons -->
                <Border Grid.Column="1">
                    <ScrollViewer Style="{DynamicResource RoundedScrollBarScrollViewerStyle}">
                        <StackPanel>

                            <Label
                                Content="USER SETTINGS"/>
                            <Button Content="Placeholder"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
