<UserControl x:Class="Cronus.Views.BookDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.Views"
             mc:Ignorable="d">
    
    <Grid>
        <Border Style="{StaticResource ViewBorderStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #View Title -->
                <Label
                    Grid.Row="0"
                    Content="Book Details"
                    Style="{StaticResource ViewTitleLabelStyle}"/>
                
                <!-- #Details Content -->
                <Border Grid.Row="1" Margin="0,20,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource AccentBorderBackground}" CornerRadius="8,8,0,0"/>

                        <Border
                            Grid.Row="1"
                            Background="{StaticResource ControlBackgroundFillColorBrush1}"
                            Padding="10"
                            CornerRadius="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Column="0"
                                        Content="{Binding CurrentBook.Name}"
                                        Style="{StaticResource ViewTitleLabelStyle}"
                                        FontSize="16" FontWeight="Bold"
                                        Margin="20"/>
                                    <Button
                                        Grid.Column="1"
                                        Content="Edit Book Details"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Center"/>
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    Background="{StaticResource LayerFillColorBrush2}"
                                    Margin="0,10,0,0" Padding="15"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>

                                            <Style TargetType="StackPanel">
                                                <Setter Property="Margin" Value="0,5"/>
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Column="0" Grid.Row="0">
                                            <Label
                                                Content="NAME"
                                                Style="{StaticResource DetailsFieldHeaderLabelStyle}"/>
                                            <Label
                                                Content="{Binding CurrentBook.Name}"
                                                Style="{StaticResource DetailsFieldStrongLabelStyle}"/>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1" Grid.Row="0"
                                            Content="Edit"/>

                                        <StackPanel Grid.Column="0" Grid.Row="1">
                                            <Label
                                                Content="CREATED ON"
                                                Style="{StaticResource DetailsFieldHeaderLabelStyle}"/>
                                            <Label
                                                Content="{Binding CurrentBook.CreatedDateString}"
                                                Style="{StaticResource DetailsFieldLabelStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- #Removal Controls -->
                        <Border
                            Grid.Row="2"
                            BorderBrush="{StaticResource AccentBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,30,0,0" Padding="0,40,0,15">
                            <StackPanel>
                                <Label
                                    Content="BOOK REMOVAL"
                                    Margin="0,0,0,15"/>
                                <TextBlock Text="Deleting this book means you cannot recover it at any time after taking this action."/>

                                <StackPanel Orientation="Horizontal" Margin="0,15,0,40">
                                    <Button
                                        Content="Archive Book"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Margin="0,0,15,0"/>
                                    <Button
                                        Content="Delete Book"
                                        Style="{StaticResource EmptyDeleteButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Border>
    </Grid>
    
</UserControl>
