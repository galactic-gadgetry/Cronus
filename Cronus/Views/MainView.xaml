<Window x:Class="Cronus.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cronus.Views"
        xmlns:ui="clr-namespace:Cronus.UIComponents"
        xmlns:vm="clr-namespace:Cronus.ViewModels"
        mc:Ignorable="d"
        Style="{StaticResource DefaultWindowStyle}"
        MinHeight="510" MinWidth="950"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Border>

            <ContentControl Content="{Binding CurrentContentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:LayoutViewModel}">
                        <ui:Layout/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:StartScreenViewModel}">
                        <local:StartScreenView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
            
        </Border>
    </Grid>
    
</Window>
