<Window x:Class="Cronus.UIComponents.Dialogs.MessageWithBackButtonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cronus.UIComponents.Dialogs"
        mc:Ignorable="d"
        Title="Message with Back Button"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">

    <Grid>
        <Border
            Style="{StaticResource DialogOutterBorderStyle}"
            Height="Auto">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DialogContentBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label
                            x:Name="TitleLabel"
                            Grid.Row="0"
                            Content="Title"
                            Foreground="{StaticResource TextAccentFillColorBrush1}"
                            FontSize="18"/>

                        <TextBlock
                            x:Name="MessageTextBlock"
                            Grid.Row="1"
                            Text="This is a super duper test message!"
                            Foreground="{StaticResource TextFillColorBrush1}"
                            HorizontalAlignment="Center"
                            Margin="0,5"/>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource DialogControlBorderStyle}"
                    Background="{StaticResource ControlBackgroundFillColorBrush2}">
                    <Button
                        Content="Back"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        Click="BackButton_Click"/>
                </Border>
            </Grid>

        </Border>
    </Grid>
</Window>
