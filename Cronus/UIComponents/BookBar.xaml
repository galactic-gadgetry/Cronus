<UserControl x:Class="Cronus.UIComponents.BookBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cronus.UIComponents"
             mc:Ignorable="d" d:DesignWidth="240">
    
    <Grid>
        <Border>

            <Grid>
                <Grid.Resources>
                    
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.55*"/>
                    <ColumnDefinition Width="0.45*"/>
                </Grid.ColumnDefinitions>
                
                <!-- #Current Book Button -->
                <Button
                    Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource BookGray}"/>

                        <StackPanel>
                            <StackPanel.Resources>
                                
                            </StackPanel.Resources>
                            <Label
                                Content="Test Book"/>
                            <Label
                                Content="Active"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                
                <!-- #Control Buttons -->
                <Grid Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            
                        </StackPanel.Resources>
                        <Button
                            Content="S">
                            <Image>
                                <Image.Resources>
                                    
                                </Image.Resources>
                            </Image>
                        </Button>
                        <Button
                            Content="E"/>
                    </StackPanel>
                </Grid>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
